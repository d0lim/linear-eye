{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linear-eye",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "REPORT_TIMEZONE": "Asia/Seoul",
    "STALE_ISSUE_DAYS": "5",
    "PROJECT_UPDATE_BODY_LIMIT": "8000"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "linear-eye",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{"binding": "LINEAR_EYE_QUEUE", "queue": "linear-eye-events"}],
    "consumers": [{
      "queue": "linear-eye-events",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_retries": 5,
      "dead_letter_queue": "linear-eye-dead-letter"
    }]
  },
  "triggers": {"crons": ["0 18 * * *"]},
  "observability": {"enabled": true}
}
