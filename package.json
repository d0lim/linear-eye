{
  "name": "linear-eye",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply linear-eye --local",
    "db:migrate:remote": "wrangler d1 migrations apply linear-eye --remote"
  },
  "dependencies": {
    "agents": "0.24.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.3.6",
    "effect": "4.0.0-rc.118",
    "@effect/sql-d1": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "typescript": "~5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "4.143.0"
  }
}
