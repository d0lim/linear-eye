{
  "name": "linear-eye",
  "version": "0.1.0",
  "description": "Read-only Linear intelligence through MCP, powered by Effect and Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d0lim/linear-eye.git"
  },
  "homepage": "https://github.com/d0lim/linear-eye#readme",
  "bugs": {
    "url": "https://github.com/d0lim/linear-eye/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm run build:web && wrangler dev",
    "deploy": "pnpm run build:web && wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "db:migrate:local": "wrangler d1 migrations apply linear-eye --local",
    "db:migrate:remote": "wrangler d1 migrations apply linear-eye --remote",
    "dev:web": "vite",
    "build:web": "vite build"
  },
  "dependencies": {
    "@effect/sql-d1": "4.0.0-rc.118",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "effect": "4.0.0-rc.118",
    "jose": "6.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "latest",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "~5.9.3",
    "vite": "8.3.1",
    "vitest": "~4.1.0",
    "wrangler": "4.143.0"
  }
}
